# Copia este archivo a ".env" y completa los valores antes de correr el proyecto.

DATABASE_URL="file:./dev.db"

# Genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="reemplaza-esto-con-una-cadena-aleatoria-larga"

# Contraseña de administrador, codificada en base64 (ver README para más detalle).
# Genera la tuya con: node scripts/hash-password.js "tu-contraseña"
ADMIN_PASSWORD_HASH_B64="reemplaza-esto-con-el-resultado-del-script"
