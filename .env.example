# Copia este archivo a ".env" y completa los valores antes de correr el proyecto.

# Cadena de conexión de una base de datos Postgres. En desarrollo y en
# producción (Vercel) usamos Neon (https://neon.tech, tiene plan gratuito).
# Créala en el dashboard de Neon o mediante la integración de Vercel
# ("Storage" → "Postgres" en tu proyecto de Vercel), y pega aquí la cadena
# que te den (empieza con postgresql://...).
DATABASE_URL="postgresql://usuario:contraseña@host/basededatos?sslmode=require"

# Genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="reemplaza-esto-con-una-cadena-aleatoria-larga"

# Contraseña de administrador, codificada en base64 (ver README para más detalle).
# Genera la tuya con: node scripts/hash-password.js "tu-contraseña"
ADMIN_PASSWORD_HASH_B64="reemplaza-esto-con-el-resultado-del-script"

# Solo necesario en producción (Vercel la agrega sola al conectar un Blob
# store a tu proyecto). Déjala vacía en desarrollo local: las imágenes se
# guardan en public/uploads automáticamente si no está definida.
BLOB_READ_WRITE_TOKEN=""
